PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Uzun tasodifiy qator qo‘ying. Bo‘sh qolsa, data/.jwt-secret avtomatik yaratiladi.
JWT_SECRET=

# PostgreSQL (pgAdmin'da yaratilgan baza). Variant 1 — bitta URL:
# DATABASE_URL=postgresql://postgres:PAROL@localhost:5432/multikids
# Variant 2 — alohida o‘zgaruvchilar:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=multikids
# Bulutdagi bazalar (Neon, Supabase, Render...) uchun true qiling:
DATABASE_SSL=false
