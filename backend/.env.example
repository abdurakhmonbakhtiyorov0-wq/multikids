PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# MAJBURIY. Kamida 32 belgili tasodifiy qator. Uni o‘zingiz yarating:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Qiymatni hech qachon Git'ga qo‘ymang; Vercel'da Settings -> Environment Variables orqali kiriting.
JWT_SECRET=

# PostgreSQL. Variant 1 — bitta URL (Neon / Supabase / Render / lokal):
# DATABASE_URL=postgresql://postgres:PAROL@localhost:5432/multikids
# Variant 2 — alohida o‘zgaruvchilar (pgAdmin'dagi lokal baza):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=multikids
# Bulutdagi bazalar (Neon, Supabase, Render...) uchun true qiling:
DATABASE_SSL=false
# Serverless'da (Vercel) har bir nusxaga kichik pool yetarli:
# PG_POOL_MAX=3
