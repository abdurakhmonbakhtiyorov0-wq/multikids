PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# MAJBURIY. Kamida 32 belgili tasodifiy qator. Uni o‘zingiz yarating:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Qiymatni hech qachon Git'ga qo‘ymang; Vercel'da Settings -> Environment Variables orqali kiriting.
JWT_SECRET=

# PostgreSQL. Variant 1 — bitta URL (Neon / Supabase / Render / lokal):
# DATABASE_URL=postgresql://postgres:PAROL@localhost:5432/multikids
# Variant 2 — alohida o‘zgaruvchilar (pgAdmin'dagi lokal baza):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=multikids
# Bulutdagi bazalar (Neon, Supabase, Render...) uchun true qiling:
DATABASE_SSL=false
# Serverless'da (Vercel) har bir nusxaga kichik pool yetarli:
# PG_POOL_MAX=3

# Parolni tiklash xatlari (SMTP). Sozlanmasa, "Parolni unutdingizmi?" aniq xato qaytaradi.
# Variant 1 — bitta URL (masalan Gmail: smtps://EMAIL:APP_PASSWORD@smtp.gmail.com:465, Resend: smtps://resend:API_KEY@smtp.resend.com:465)
# SMTP_URL=
# Variant 2 — alohida:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Xatdagi "Kimdan" manzil va saytning ochiq manzili (havola shu manzilga yaratiladi):
# MAIL_FROM=MultiKids <no-reply@sizning-domen.uz>
# APP_URL=https://multikids-q7zt.vercel.app
